{
  "manifest_version": 3,
  "name": "LPU Auto Login",
  "version": "1.1",
  "description": "Automatically fills and submits the login form on LPU internet portal using credentials saved locally in your browser.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://internet.lpu.in/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://internet.lpu.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}